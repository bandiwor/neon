// Built-in fallible operations return Option / Result instead of trapping.
let a: i8 = 100;
println(a.checked_add(27));
println(a.checked_add(28));
println(5.checked_div(0));
println(7u8.checked_sub(8u8));
println(i32::MIN.checked_neg());
println(2i64.checked_pow(62u32));
println(2i64.checked_pow(63u32));
println(1u8.checked_shl(8u8));
let xs = [10, 20, 30];
println(xs.get(1)); println(xs.get(3)); println(xs.get(-1));
let mut ys = [1, 2];
println(ys.try_pop()); println(ys.try_pop()); println(ys.try_pop());
let m = {"a": 1};
println(m.get("a")); println(m.get("z"));
println("42".try_parse_i64()); println("x".try_parse_i64()); println("2.5".try_parse_f64());
println("héllo".get_char(1)); println("abc".get_char(9));
println("abcdef".try_substring(1, 3)); println("abc".try_substring(2, 9));
println("banana".index_of("nan")); println("banana".index_of("z"));
println(xs.get(1).map(|v| => v * 2).unwrap_or(0));
println(xs.get(9).unwrap_or(-1));
println("12".try_parse_i64().map(|n| => n + 1).unwrap());
let r = "zz".try_parse_i64();
match r { Result::Ok(n) => println(n), Result::Err(e) => println("failed: " + e) }
println(xs.get(0).ok_or("none").is_ok());
println(read_line());
println(read_line().is_none());
