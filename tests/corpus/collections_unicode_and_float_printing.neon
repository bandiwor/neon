// maps, sets, sort, strings, unicode
struct P { name: string, age: i32 }
enum Shape { Circle(f64), Rect(f64, f64), Empty }
fn main() {
    var m: {string: [i64]} = {};
    m.insert("b", [1, 2]);
    m.insert("a", [3]);
    m.insert("c", []);
    println(m);
    println(m.remove("a"));
    println(m.remove("zz"));
    println(m.keys());
    println(m.values());
    var s = set { "x", "y", "z" };
    s.insert("w");
    s.remove("y");
    println(s);
    println(s.to_array());
    var fl = [3.5, 1.0, 0.0 / 0.0, -2.25, 10.0];
    fl.sort();
    println(fl);
    var ss = ["pear", "apple", "fig", "Zed", "été"];
    ss.sort();
    println(ss);
    println(ss.join("|"));
    println("héllo wörld ÄÖÜ ñ".to_upper());
    println("HÉLLO WÖRLD".to_lower());
    println("héllo".len());
    println("héllo".char_at(1));
    println("héllo".substring(1, 3));
    println("héllo".find("llo"));
    println("a--b--c".split("--"));
    println("abc".split(""));
    println("  \t x y \n ".trim() + "|");
    println([P { name: "ann", age: 3 }, P { name: "bob", age: -4 }]);
    println([Shape::Circle(1.5), Shape::Rect(2.0, 3.0), Shape::Empty]);
    println(set { 3, 1, 2 });
    println({ 1: "one", 2: "two" });
    println(["a\"b", "c\nd"]);
    println(['a', '\'', '\n']);
    for v in [1.0e20, 1.5e-7, 0.1 + 0.2, 100.0, 1.0e15, 123456789.125, 1.0e16, 0.0001, 0.00001, -0.0, 1.0 / 0.0, -1.0 / 0.0] { println(v); }
    let x: f32 = 0.1;
    println(x);
    println(x * 3.0);
    println(16777216.0f32);
}
