// A recursive enum evaluated with pattern matching.
enum Expr { Num(i64), Add(Expr, Expr), Mul(Expr, Expr), Neg(Expr) }
fn eval(e: Expr) -> i64 {
    match e {
        Expr::Num(n) => n,
        Expr::Add(a, b) => eval(a) + eval(b),
        Expr::Mul(a, b) => eval(a) * eval(b),
        Expr::Neg(a) => -eval(a),
    }
}
fn show(e: Expr) -> string {
    match e {
        Expr::Num(n) => n.to_string(),
        Expr::Add(a, b) => "(" + show(a) + " + " + show(b) + ")",
        Expr::Mul(a, b) => show(a) + " * " + show(b),
        Expr::Neg(a) => "-" + show(a),
    }
}
let e = Expr::Add(Expr::Mul(Expr::Num(3), Expr::Num(4)), Expr::Neg(Expr::Num(5)));
println(show(e));
println(eval(e));
