// arithmetic across types, casts, checked ops
fn main() {
    let a: i8 = 100;
    println(a.checked_add(27));
    println(a.checked_add(28));
    println(a.checked_mul(2));
    println((-128i8).checked_neg());
    println((-128i8).checked_div(-1));
    println(7u8.checked_sub(8));
    println(2u32.checked_pow(31));
    println(2u32.checked_pow(32));
    println(10i64.checked_rem(0));
    println(1i32.checked_shl(31));
    println(1i32.checked_shl(32));
    println(-17 % 5);
    println(-17 / 5);
    println(17u32 % 5);
    println(255u8 as i8);
    println(-1i32 as u32);
    println(-1i64 as u64);
    println(3000000000u32 as i32);
    println(300i32 as u8);
    println(2.9f64 as i32);
    println(-2.9f64 as i32);
    println(1e20 as i32);
    println(-1e20 as i64);
    println(1e20 as u64);
    println(-5.0 as u32);
    println((0.0 / 0.0) as i32);
    println(300.5 as u8);
    println(7 as f32 / 2.0);
    println(i64::MAX as f64);
    println(1u64 << 63);
    println(0xFFu8 >> 3);
    println(-8i32 >> 1);
    println(5 ^ 3);
    println(5 & 3);
    println(5 | 3);
    println(!5i32);
    println(!0u8);
    println(2.0.pow(10.0));
    println(3i32.pow(4));
    println((-2.5f64).abs());
    println(9.0.sqrt());
    println(2.5.round());
    println(-2.5.round());
    println(2.5.floor());
    println(2.1.ceil());
    println(1.0.exp());
    println(10.0.ln());
    println(1.0.sin());
    println(3.min(4));
    println(2.5.max(1.5));
    println('a'.to_upper());
    println('Z'.to_lower());
    println('5'.is_digit());
    println('é'.is_alphabetic());
    println(' '.is_whitespace());
    println((0.0 / 0.0).is_nan());
    println(i64::MIN);
    println(u64::MAX);
    println(u8::MAX);
    println(i32::MIN);
}
