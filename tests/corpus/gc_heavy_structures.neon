struct Node { val: i64, next: Option<Node> }
struct Rec { name: string, tags: [string], score: f64, link: Option<Rec> }
fn build(n: i64) -> Option<Node> {
    var head: Option<Node> = Option::None;
    for i in 0..n { head = Option::Some(Node { val: i, next: head }); }
    head
}
fn sum(l: Option<Node>) -> i64 {
    var t = 0;
    var cur = l;
    while true {
        match cur {
            Option::Some(n) => { t += n.val; cur = n.next; }
            Option::None => break,
        }
    }
    t
}
fn main() {
    var total = 0;
    for round in 0..200 {
        let l = build(500);
        total += sum(l);
        var m: {string: Rec} = {};
        for i in 0..50 {
            let key = f"k{i % 17}";
            m.insert(key, Rec { name: key + "!", tags: [key, f"{round}"], score: i as f64 * 0.5, link: Option::None });
        }
        var arr: [string] = [];
        for k in m.keys() { arr.push(m[k].name + m[k].tags.join(",")); }
        arr.sort();
        total += arr.len() + arr[0].len();
        let big = "x".split("");
        total += big.len();
    }
    println(total);
    var s = "";
    for i in 0..2000 { s = s + f"{i},"; }
    println(s.len());
    var rs: [Rec] = [];
    for i in 0..1000 { rs.push(Rec { name: f"n{i}", tags: [], score: 1.0, link: Option::None }); }
    var chain = Rec { name: "root", tags: [], score: 0.0, link: Option::None };
    for r in rs { chain = Rec { name: r.name, tags: r.tags, score: r.score, link: Option::Some(chain) }; }
    var depth = 0;
    var c = Option::Some(chain);
    while true { match c { Option::Some(r) => { depth += 1; c = r.link; } Option::None => break } }
    println(depth);
}
