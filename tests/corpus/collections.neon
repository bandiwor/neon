let mut a = [3, 1, 2]; a.push(4); println(a.len()); println(a); a.sort(); println(a); println(a.pop()); a.reverse(); println(a); println(a[0] + a[1]);
let mut m = { "b": 2, "a": 1 }; m.insert("c", 3); m["a"] = 10; println(m["a"]); println(m.len()); println(m.contains_key("z")); println(m.get_or("z", -1)); println(m);
println(m.keys()); println(m.values());
let mut s = set { 1, 2, 2, 3 }; println(s.len()); println(s.insert(2)); println(s.insert(9)); println(s.contains(9)); println(s.remove(1)); println(s);
let mut total = 0; for x in a { total += x; } for k in m.keys() { total += m[k]; } for e in s { total += e; } println(total);
