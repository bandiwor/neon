let nums = [5, 3, 8, 1, 9, 2];
println(nums.map(|x| => x * 2));
println(nums.filter(|x| => x % 2 == 1));
nums.for_each(|x| => print(f"{x} "));
println("");
println(nums.fold(0, |a, x| => a + x));
println(nums.sum());
println(nums.product());
println(nums.max());
println(nums.min());
println(nums.sorted());
println(nums.reversed());
println(nums.take(2));
println(nums.skip(4));
println(nums.first());
println(nums.last());
println(nums.any(|x| => x > 8));
println(nums.all(|x| => x > 1));
println(nums.count(|x| => x > 4));
println(nums.find(|x| => x > 5));
println(nums.position(|x| => x == 8));
println(nums.reduce(|a, b| => a * b));
println(nums.filter_map(|x| => if x > 4 { Option::Some(x * 100) } else { Option::None }));
println(nums.take(2).flat_map(|x| => [x, x]));
let fs = [1.5, 2.5];
println(fs.sum());
let words = ["pear", "fig", "apple"];
println(words.map(|w| => w.len()));
println(words.max());
println(words.sorted().join(","));
let empty: [i64] = [];
println(empty.sum());
println(empty.max());
println(empty.first());
println(empty.reversed());
println(Option::Some(4).filter(|x| => x > 5));
println(Option::Some(4).is_some_and(|x| => x == 4));
println(Option::None.or_else(|| => Option::Some(1)));
