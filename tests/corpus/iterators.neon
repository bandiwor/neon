fn main() {
    let xs = [5, 3, 8, 1, 9, 2];
    var total = 0;
    xs.iter().for_each(|x| => total += x);
    println(total);
    println(xs.iter().rev().collect());
    println((0..5).rev().collect());
    println((0..=5).rev().map(|x| => x * 2).collect());
    println(xs.iter().take(3).collect());
    println(xs.iter().skip(4).collect());
    println(xs.iter().take(4).skip(1).collect());
    println(xs.iter().step_by(2).collect());
    println(xs.iter().take_while(|x| => x > 2).collect());
    println(xs.iter().skip_while(|x| => x > 2).collect());
    println(xs.iter().chain(10..13).collect());
    println(xs.iter().zip(10..).collect());
    println(xs.iter().zip(xs.iter().map(|x| => x * 2)).map(|p| => p.0 + p.1).collect());
    println((1..4).flat_map(|x| => [x, x * 10]).collect());
    println(
        xs
            .iter()
            .filter_map(|x| => if x > 4 { Option::Some(x * 100) } else { Option::None })
            .collect()
    );
    println(xs.iter().any(|x| => x == 9));
    println(xs.iter().all(|x| => x < 9));
    println(xs.iter().find(|x| => x > 5));
    println(xs.iter().position(|x| => x == 1));
    println(xs.iter().first());
    println(xs.iter().last());
    println(xs.iter().nth(2));
    println(xs.iter().max());
    println(xs.iter().min());
    println(xs.iter().max_by_key(|x| => 10 - x));
    println(xs.iter().count());
    println(xs.iter().fold(0, |a, x| => a * 2 + x));
    println(xs.iter().reduce(|a, b| => a - b));
    println(["a", "b", "c"].iter().map(|s| => s + "!").join(","));
    let it = xs.iter().filter(|x| => x % 2 == 1);
    println(it.count());
    println(it.sum());
    let n = 3;
    println(xs.iter().map(|x| => x + n).sum());
    println(xs.iter().map(|x| => {
        if x > 4 { return 0; }
        x
    }).sum());
    println((1..=3).map(|i| => i as f64 * 1.5).sum());
    println((0..0).sum());
    println((5..3).collect());
    println(xs.iter().inspect(|x| => print(f"<{x}>")).take(2).count());
    println((1..10).take(0).count());
    for x in xs.iter().rev().skip(1) {
        if x == 3 { break; }
        print(f"{x} ");
    }
    println("");
    let r = 2..6;
    println(r);
    println(r.contains(4));
    println(r.map(|x| => x + 1).collect());
    println((250u8..=255).map(|x| => x as i64).sum());
}
