var i = 0; var s = 0; while i < 5 { s += i; i += 1; } println(s);
let a = if s > 5 { "big" } else { "small" }; println(a);
var n = 0; let r = loop { n += 1; if n == 4 { break n * 10; } }; println(r);
for k in 0..3 { print(k); } println(""); for k in 1..=3 { print(k); } println("");
for k in 0..10 { if k % 2 == 0 { continue; } if k > 6 { break; } print(k); } println("");
