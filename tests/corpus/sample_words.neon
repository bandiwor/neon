// Maps with string keys, splitting and sorted output.
let text = "the quick brown fox jumps over the lazy dog the end";
let mut counts: {string: i64} = {};
for w in text.split(" ") {
    counts[w] = counts.get_or(w, 0) + 1;
}
let mut keys = counts.keys();
keys.sort();
for k in keys { println(k + ": " + counts[k].to_string()); }
println(counts.len());
