// The Neon prelude: traits behind the operators. Arithmetic, comparison and
// formatting of primitive types are built into the compiler; these traits let
// user types opt in with `impl Add<Rhs> for MyType { .. }` and so on.

export trait Add<Rhs> { fn add(self, rhs: Rhs) -> Self; }
export trait Sub<Rhs> { fn sub(self, rhs: Rhs) -> Self; }
export trait Mul<Rhs> { fn mul(self, rhs: Rhs) -> Self; }
export trait Div<Rhs> { fn div(self, rhs: Rhs) -> Self; }
export trait Rem<Rhs> { fn rem(self, rhs: Rhs) -> Self; }
export trait BitAnd<Rhs> { fn bitand(self, rhs: Rhs) -> Self; }
export trait BitOr<Rhs> { fn bitor(self, rhs: Rhs) -> Self; }
export trait BitXor<Rhs> { fn bitxor(self, rhs: Rhs) -> Self; }
export trait Shl<Rhs> { fn shl(self, rhs: Rhs) -> Self; }
export trait Shr<Rhs> { fn shr(self, rhs: Rhs) -> Self; }
export trait Neg { fn neg(self) -> Self; }
export trait Not { fn not(self) -> Self; }

// `==` and `!=`; only `eq` must be written.
export trait Eq {
    fn eq(self, other: Self) -> bool;
    fn ne(self, other: Self) -> bool { !self.eq(other) }
}

// `<`, `<=`, `>`, `>=`; only `lt` must be written.
export trait Ord {
    fn lt(self, other: Self) -> bool;
    fn le(self, other: Self) -> bool { !other.lt(self) }
    fn gt(self, other: Self) -> bool { other.lt(self) }
    fn ge(self, other: Self) -> bool { !self.lt(other) }
}

// Conversion to text, used by `println` for user types.
export trait Display {
    fn to_string(self) -> string;
}

// ---- Option and Result --------------------------------------------------------------
//
// The built-in fallible operations (`checked_add`, `get`, `try_pop`,
// `try_parse_i64`, `read_line`, ...) return these instead of stopping the
// program. The order of the variants is part of the VM's contract:
// Some = 0, None = 1, Ok = 0, Err = 1.

export enum Option<T> { Some(T), None }

impl<T> Option<T> {
    fn is_some(self) -> bool {
        match self { Option::Some(_) => true, Option::None => false }
    }
    fn is_none(self) -> bool {
        match self { Option::Some(_) => false, Option::None => true }
    }
    fn unwrap(self) -> T {
        match self {
            Option::Some(v) => v,
            Option::None => panic("called `unwrap` on a `None` value"),
        }
    }
    fn expect(self, message: string) -> T {
        match self { Option::Some(v) => v, Option::None => panic(message) }
    }
    fn unwrap_or(self, default: T) -> T {
        match self { Option::Some(v) => v, Option::None => default }
    }
    fn unwrap_or_else(self, f: fn() -> T) -> T {
        match self { Option::Some(v) => v, Option::None => f() }
    }
    fn map<U>(self, f: fn(T) -> U) -> Option<U> {
        match self { Option::Some(v) => Option::Some(f(v)), Option::None => Option::None }
    }
    fn and_then<U>(self, f: fn(T) -> Option<U>) -> Option<U> {
        match self { Option::Some(v) => f(v), Option::None => Option::None }
    }
    fn or(self, other: Option<T>) -> Option<T> {
        match self { Option::Some(v) => Option::Some(v), Option::None => other }
    }
    fn or_else(self, f: fn() -> Option<T>) -> Option<T> {
        match self { Option::Some(v) => Option::Some(v), Option::None => f() }
    }
    fn filter(self, keep: fn(T) -> bool) -> Option<T> {
        match self {
            Option::Some(v) => if keep(v) { Option::Some(v) } else { Option::None },
            Option::None => Option::None,
        }
    }
    fn is_some_and(self, test: fn(T) -> bool) -> bool {
        match self { Option::Some(v) => test(v), Option::None => false }
    }
    fn ok_or<E>(self, err: E) -> Result<T, E> {
        match self { Option::Some(v) => Result::Ok(v), Option::None => Result::Err(err) }
    }
}

export enum Result<T, E> { Ok(T), Err(E) }

impl<T, E> Result<T, E> {
    fn is_ok(self) -> bool {
        match self { Result::Ok(_) => true, Result::Err(_) => false }
    }
    fn is_err(self) -> bool {
        match self { Result::Ok(_) => false, Result::Err(_) => true }
    }
    fn unwrap(self) -> T {
        match self {
            Result::Ok(v) => v,
            Result::Err(_) => panic("called `unwrap` on an `Err` value"),
        }
    }
    fn expect(self, message: string) -> T {
        match self { Result::Ok(v) => v, Result::Err(_) => panic(message) }
    }
    fn unwrap_or(self, default: T) -> T {
        match self { Result::Ok(v) => v, Result::Err(_) => default }
    }
    fn unwrap_or_else(self, f: fn(E) -> T) -> T {
        match self { Result::Ok(v) => v, Result::Err(e) => f(e) }
    }
    fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self { Result::Ok(v) => Result::Ok(f(v)), Result::Err(e) => Result::Err(e) }
    }
    fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self { Result::Ok(v) => Result::Ok(v), Result::Err(e) => Result::Err(f(e)) }
    }
    fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self { Result::Ok(v) => f(v), Result::Err(e) => Result::Err(e) }
    }
    fn ok(self) -> Option<T> {
        match self { Result::Ok(v) => Option::Some(v), Result::Err(_) => Option::None }
    }
    fn err(self) -> Option<E> {
        match self { Result::Ok(_) => Option::None, Result::Err(e) => Option::Some(e) }
    }
}

// ---- arrays -------------------------------------------------------------------------
//
// Combinators over arrays, written in Neon itself: each takes a closure and builds a new array (or a
// value); `nums.filter(|x| => x > 0).map(|x| => x * 2)` reads left to right. The arrays they
// are called on are not changed.

impl<T> [T] {
    fn map<U>(self, f: fn(T) -> U) -> [U] {
        var out: [U] = [];
        for x in self { out.push(f(x)); }
        out
    }
    fn filter(self, keep: fn(T) -> bool) -> [T] {
        var out: [T] = [];
        for x in self { if keep(x) { out.push(x); } }
        out
    }
    fn filter_map<U>(self, f: fn(T) -> Option<U>) -> [U] {
        var out: [U] = [];
        for x in self {
            match f(x) { Option::Some(v) => out.push(v), Option::None => {} }
        }
        out
    }
    fn flat_map<U>(self, f: fn(T) -> [U]) -> [U] {
        var out: [U] = [];
        for x in self { for y in f(x) { out.push(y); } }
        out
    }
    fn for_each(self, f: fn(T)) {
        for x in self { f(x); }
    }
    fn fold<A>(self, init: A, f: fn(A, T) -> A) -> A {
        var acc = init;
        for x in self { acc = f(acc, x); }
        acc
    }
    fn reduce(self, f: fn(T, T) -> T) -> Option<T> {
        var acc: Option<T> = Option::None;
        for x in self {
            acc = match acc {
                Option::Some(a) => Option::Some(f(a, x)),
                Option::None => Option::Some(x),
            };
        }
        acc
    }
    fn any(self, test: fn(T) -> bool) -> bool {
        for x in self { if test(x) { return true; } }
        false
    }
    fn all(self, test: fn(T) -> bool) -> bool {
        for x in self { if !test(x) { return false; } }
        true
    }
    fn count(self, test: fn(T) -> bool) -> i64 {
        var n = 0;
        for x in self { if test(x) { n += 1; } }
        n
    }
    fn find(self, test: fn(T) -> bool) -> Option<T> {
        for x in self { if test(x) { return Option::Some(x); } }
        Option::None
    }
    fn position(self, test: fn(T) -> bool) -> Option<i64> {
        var i = 0;
        for x in self {
            if test(x) { return Option::Some(i); }
            i += 1;
        }
        Option::None
    }
    fn first(self) -> Option<T> { self.get(0) }
    fn last(self) -> Option<T> { self.get(self.len() - 1) }
    fn take(self, n: i64) -> [T] {
        var out: [T] = [];
        var i = 0;
        for x in self {
            if i >= n { break; }
            out.push(x);
            i += 1;
        }
        out
    }
    fn skip(self, n: i64) -> [T] {
        var out: [T] = [];
        var i = 0;
        for x in self {
            if i >= n { out.push(x); }
            i += 1;
        }
        out
    }
    fn reversed(self) -> [T] {
        var out: [T] = [];
        var i = self.len() - 1;
        while i >= 0 {
            out.push(self[i]);
            i -= 1;
        }
        out
    }
}

impl<T: Ord> [T] {
    fn max(self) -> Option<T> {
        self.reduce(|a, b| => if b > a { b } else { a })
    }
    fn min(self) -> Option<T> {
        self.reduce(|a, b| => if b < a { b } else { a })
    }
    // A stable merge sort; the original array is left alone (`xs.clone()` + `sort()` sorts in place).
    fn sorted(self) -> [T] {
        let n = self.len();
        if n <= 1 { return self.take(n); }
        let left = self.take(n / 2).sorted();
        let right = self.skip(n / 2).sorted();
        var out: [T] = [];
        var i = 0;
        var j = 0;
        while i < left.len() && j < right.len() {
            if right[j] < left[i] {
                out.push(right[j]);
                j += 1;
            } else {
                out.push(left[i]);
                i += 1;
            }
        }
        while i < left.len() { out.push(left[i]); i += 1; }
        while j < right.len() { out.push(right[j]); j += 1; }
        out
    }
}

// Sums and products. The 64-bit types come first: an array of bare literals (`[1, 2, 3]`) uses the first
// impl that fits, and `i64` / `f64` are the defaults.

impl [i64] {
    fn sum(self) -> i64 {
        var total: i64 = 0;
        for x in self { total += x; }
        total
    }
    fn product(self) -> i64 {
        var total: i64 = 1;
        for x in self { total *= x; }
        total
    }
}

impl [i32] {
    fn sum(self) -> i32 {
        var total: i32 = 0;
        for x in self { total += x; }
        total
    }
    fn product(self) -> i32 {
        var total: i32 = 1;
        for x in self { total *= x; }
        total
    }
}

impl [i16] {
    fn sum(self) -> i16 {
