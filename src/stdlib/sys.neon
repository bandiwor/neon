// `sys`: the program's surroundings.
//
//     import "sys" as sys;
//     println(sys::args());
//
// The functions without a body are native: the virtual machine and the C translation provide them.

// The command-line arguments after the program (`neon run prog.neon -- a b`).
export fn args() -> [string];

// Ends the program with this exit status; what was printed is kept.
export fn exit(code: i64);

// The value of an environment variable.
export fn env(name: string) -> Option<string>;

// "linux", "macos", "windows", ...
export fn platform() -> string;

// Milliseconds since 1970-01-01 UTC.
export fn now_ms() -> i64;

// Milliseconds on a clock that only goes forward: take the difference of two readings.
export fn ticks_ms() -> i64;

// Waits for this many milliseconds.
export fn sleep(ms: i64);
