// An interactive terminal paint program: it reacts to every key press, no Enter needed.
//
//   arrows, w a s d, h j k l   move the brush (Ctrl+arrow: four cells at a time)
//   space, Enter               stamp the brush        p   pen down: stamp while moving
//   t   next tool (dot / line / box / disc)           1-5 pick a color     c   next color
//   + -  (or PageUp / PageDown) change the brush size
//   u   undo the last stamp    x   clear the canvas   s   save the picture to paint.txt
//   q, Esc, Ctrl+C   quit
//
// `neon run examples/paint.neon` (add `-- --plain` to print every frame instead of redrawing in place;
// that is also what happens when the input is not a terminal, so keys can be piped in).
// The same program translates to C with `neon c examples/paint.neon`.
//
// What it shows: the `term` module (raw mode, `read_key`, `poll_key` for the blinking brush, the
// screen helpers), `fs` (saving the picture) and `sys` (the arguments); compact enums (`Color`,
// `Shape`: one word each, no allocation), tuples, ranges as values and fused lazy iterator chains.

import "fs" as fs;
import "sys" as sys;
import "term" as term;

enum Color { Black, Gray(u8), Rgb(u8, u8, u8) }

enum Shape {
    Dot(u8, u8),
    HLine(u8, u8, u8),
    Rect(u8, u8, u8, u8),
    Circle(u8, u8, u8),
}

enum Op { Draw(Shape, Color), Clear }

const W: i64 = 48;
const H: i64 = 18;
const PALETTE_SIZE: i64 = 5;

fn palette(i: i64) -> Color {
    match i % PALETTE_SIZE {
        0 => Color::Gray(70),
        1 => Color::Gray(130),
        2 => Color::Rgb(200, 150, 60),
        3 => Color::Rgb(250, 240, 200),
        _ => Color::Black,
    }
}

impl Color {
    fn brightness(self) -> i64 {
        match self {
            Color::Black => 0,
            Color::Gray(v) => v as i64,
            Color::Rgb(r, g, b) => (2 * (r as i64) + 5 * (g as i64) + (b as i64)) / 8,
        }
    }

    fn glyph(self) -> char {
        let b = self.brightness();
        if b == 0 {
            ' '
        } elif b < 100 {
            '.'
        } elif b < 160 {
            ':'
        } elif b < 220 {
            'o'
        } else {
            '#'
        }
    }
}

impl Display for Color {
    fn to_string(self) -> string {
        match self {
            Color::Black => "eraser",
            Color::Gray(v) => f"gray {v}",
            Color::Rgb(r, g, b) => f"rgb {r},{g},{b}",
        }
    }
}

// Does the shape cover the point p?
fn covers(s: Shape, p: (i64, i64)) -> bool {
    let (x, y) = p;
    match s {
        Shape::Dot(dx, dy) => x == dx as i64 && y == dy as i64,
        Shape::HLine(lx, ly, len) => y == ly as i64
            && x >= lx as i64
            && x < (lx as i64) + (len as i64),
        Shape::Rect(rx, ry, w, h) => {
            let xs = (rx as i64)..((rx as i64) + (w as i64));
            let ys = (ry as i64)..((ry as i64) + (h as i64));
            xs.contains(x) && ys.contains(y)
        }
        Shape::Circle(cx, cy, r) => {
            let dx = x - cx as i64;
            let dy = (y - cy as i64) * 2; // a character cell is about twice as tall as wide
            dx * dx + dy * dy <= (r as i64) * (r as i64)
        }
    }
}

// the line without its trailing spaces
fn rstrip(s: string) -> string {
    var n = s.len();
    while n > 0 && s.char_at(n - 1) == ' ' {
        n -= 1;
    }
    s.substring(0, n)
}

fn clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { lo } elif v > hi { hi } else { v }
}

struct Editor {
    pos: (i64, i64),
    tool: i64,
    size: i64,
    color: i64,
    pen: bool,
    blink: bool,
    message: string,
    ops: [Op],
    running: bool,
}

impl Editor {
    fn new() -> Editor {
        Editor {
            pos: (W / 2, H / 2),
            tool: 3,
            size: 4,
            color: 3,
            pen: false,
            blink: true,
            message: "",
            ops: [],
            running: true
        }
    }

    // the shape the brush would stamp right now
    fn brush(self) -> Shape {
        let (x, y) = self.pos;
        let s = self.size as u8;
        match self.tool % 4 {
            0 => Shape::Dot(x as u8, y as u8),
            1 => Shape::HLine(x as u8, y as u8, s * 2),
            2 => Shape::Rect(x as u8, y as u8, s * 2, s),
            _ => Shape::Circle(x as u8, y as u8, s),
        }
    }

    fn tool_name(self) -> string {
        match self.tool % 4 {
            0 => "dot",
            1 => "line",
            2 => "box",
            _ => "disc",
        }
    }

    fn stamp(var self) {
        self.ops.push(Op::Draw(self.brush(), palette(self.color)));
    }

    fn step(var self, dx: i64, dy: i64) {
        let (x, y) = self.pos;
        self.pos = (clamp(x + dx, 0, W - 1), clamp(y + dy, 0, H - 1));
        if self.pen {
            self.stamp();
        }
    }

    // a key by name (see `term`): what it does
    fn press(var self, key: string) {
        self.message = "";
        match key {
            "left" | "a" | "h" => self.step(-1, 0),
            "right" | "d" | "l" => self.step(1, 0),
            "up" | "w" | "k" => self.step(0, -1),
            "down" | "s" | "j" => self.step(0, 1),
            "ctrl+left" | "A" | "H" => self.step(-4, 0),
            "ctrl+right" | "D" | "L" => self.step(4, 0),
            "ctrl+up" | "W" | "K" => self.step(0, -4),
            "ctrl+down" | "S" | "J" => self.step(0, 4),
            "t" => self.tool += 1,
            "c" => self.color += 1,
            "1" | "2" | "3" | "4" | "5" => self.color = key.parse_i64() - 1,
            "+" | "=" | "pageup" => self.size = clamp(self.size + 1, 1, 12),
            "-" | "pagedown" => self.size = clamp(self.size - 1, 1, 12),
            " " | "enter" => self.stamp(),
            "p" => {
                self.pen = !self.pen;
                if self.pen {
                    self.stamp();
                }
            }
            "u" => {
                if self.ops.len() > 0 {
                    self.ops.pop();
                }
            }
            "x" => self.ops.push(Op::Clear),
            "o" => self.save(),
            "q" | "esc" | "ctrl+c" | "eof" => self.running = false,
            _ => {}
        }
    }

    // the picture as lines of text
    fn lines(self) -> [string] {
        self
            .canvas()
            .map(|row| => row.iter().map(|c| => f"{c}").join(""))
            .map(|line| => rstrip(line))
    }

    fn save(var self) {
        self.message = match fs::write_lines("paint.txt", self.lines()) {
            Result::Ok(_) => "saved to paint.txt",
            Result::Err(e) => f"cannot save: {e}",
        };
    }

    // the stamped picture, row by row
    fn canvas(self) -> [[char]] {
        var rows: [[char]] = [];
        for _ in 0..H {
            var row: [char] = [];
            for _ in 0..W {
                row.push(' ');
            }
            rows.push(row);
        }
        for op in self.ops {
            match op {
                Op::Clear => {
                    for y in 0..H {
                        for x in 0..W {
                            rows[y][x] = ' ';
                        }
                    }
                }
                Op::Draw(shape, color) => {
                    for y in 0..H {
                        for x in 0..W {
                            if covers(shape, (x, y)) {
                                rows[y][x] = color.glyph();
                            }
                        }
                    }
                }
            }
        }
        rows
    }

    fn draw(self, fancy: bool) {
        if fancy {
            term::move_to(0, 0);
        }
        var rows = self.canvas();
        // the brush outline is drawn over the picture, the brush center as an `@` that blinks
        let b = self.brush();
        for y in 0..H {
            for x in 0..W {
                if covers(b, (x, y)) && rows[y][x] == ' ' {
                    rows[y][x] = '+';
                }
            }
        }
        let (px, py) = self.pos;
        rows[py][px] = if self.blink { '@' } else { 'o' };
        let edge = "+" + (0..W).map(|i| => "-").join("") + "+";
        println(edge + if fancy { "\x1b[K" } else { "" });
        for row in rows {
            println("|" + row.iter().map(|c| => f"{c}").join("") + "|");
        }
        println(edge);
        let covered = (0..H).map(|y| => (0..W).filter(|x| => covers(b, (x, y))).count()).sum();
        let pen = if self.pen { "  pen DOWN" } else { "" };
        println(
            f"pos ({px}, {py})  tool {self.tool_name()}  size {self.size}  color {palette(self.color)}  brush covers {covered}  stamps {self.ops.len()}{pen}"
        );
        println(
            "arrows move | space stamp | p pen | t tool | +/- size | 1-5 color | u undo | x clear | o save | q quit"
        );
        println(self.message);
        if fancy {
            term::clear_below();
        }
    }
}

fn main() {
    let plain = sys::args().iter().any(|a| => a == "--plain");
    let fancy = term::is_tty() && !plain;
    term::raw(true);
    if fancy {
        term::enter_screen();
        term::hide_cursor();
    }
    var ed = Editor::new();
    var redraw = true;
    while ed.running {
        if redraw {
            ed.draw(fancy);
        }
        // a pause of half a second blinks the brush; a key does what it says
        match term::poll_key(500) {
            Option::None => {
                ed.blink = !ed.blink;
                redraw = fancy;
            },
            Option::Some(key) => {
                ed.press(key);
                redraw = true;
            },
        }
    }
    if fancy {
        term::show_cursor();
        term::leave_screen();
    }
    term::raw(false);
    println("bye");
}
